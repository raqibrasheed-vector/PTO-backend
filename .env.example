## Application settings (PTO_BACKEND_ prefix is required)
PTO_BACKEND_HOST=127.0.0.1
PTO_BACKEND_PORT=8000
PTO_BACKEND_WORKERS_COUNT=1
PTO_BACKEND_RELOAD=false
PTO_BACKEND_ENVIRONMENT=dev
PTO_BACKEND_LOG_LEVEL=INFO

## ERP integration
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
API_URL=
RESOURCE=
TOKEN_URL=

## Frontend and authentication
FRONTEND_URL=http://localhost:5173
TOKEN_SECRET=
TOKEN_AUDIENCE=actalent
COOKIE_DOMAIN=

## SAML
# Base64-encoded contents of pto_backend/saml/settings.json
SAML_SETTINGS_BASE64=

## Cosmos DB
COSMOS_DB_URL=
COSMOS_DB_NAME=
COSMOS_POOL_MAXSIZE=100
COSMOS_POOL_MAXSIZE_PER_HOST=50
COSMOS_POOL_KEEPALIVE_TIMEOUT=30
COSMOS_CONNECTION_TIMEOUT=5
COSMOS_REQUEST_TIMEOUT=5

## Document vectorization
VECTORSTORE_DIR=vectorstores
VECTORSTORE_OCR_DPI=300
VECTORSTORE_CHUNK_SIZE=2000
VECTORSTORE_CHUNK_OVERLAP=400
VECTORSTORE_DEFAULT_QUERY=Vacation Policy
VECTORSTORE_DEFAULT_TOP_K=4

## Azure OpenAI
OPENAI_ENDPOINT=
OPENAI_MODEL_DEPLOYMENT=
OPENAI_API_VERSION=
OPENAI_API_KEY=